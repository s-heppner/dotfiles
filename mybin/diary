#!/usr/bin/env bash
#
# Manage daily diary entries in the Obsidian wiki.
#
# How to use:
#
#   diary new          Create today's diary note (no-op if it already exists)
#   diary add <text>   Append a timestamped entry to today's note (creates it if needed)

set -euo pipefail

readonly DIARY_DIR="${HOME}/workspace/wiki/wiki/Journal/Daily"

usage() {
	echo "Usage: $(basename "$0") <command> [args]"
	echo ""
	echo "Commands:"
	echo "  new         Create today's diary note"
	echo "  add <text>  Append a timestamped entry to today's note"
}

die() {
	echo "Error: $*" >&2
	exit 1
}

today_file() {
	echo "${DIARY_DIR}/$(date +%F).md"
}

cmd_new() {
	local day file
	day=$(date +%F)
	file="${DIARY_DIR}/${day}.md"

	if [[ -f "$file" ]]; then
		echo "Already exists: $file"
		return
	fi

	cat >"$file" <<EOF
---
day: ${day}
location:
---
[[Diary]] entry for ${day}
## Completed Today
\`\`\`dataview
TABLE WITHOUT ID
  file.link AS Task,
  type AS Type,
  created AS Created,
  deprecated AS dep
FROM "TASKS"
WHERE
  completed = date(${day})
SORT created ASC
\`\`\`
# Notes

EOF
	echo "Created: $file"
}

cmd_add() {
	local text="$1"
	local file
	file=$(today_file)

	if [[ ! -f "$file" ]]; then
		echo "Diary file not found, creating it..." >&2
		cmd_new
	fi

	local lines=()
	mapfile -t lines <"$file"

	# Walk up from the bottom, skipping blank lines and empty bullets (a dash
	# with no text), so the new entry lands directly under the last real bullet
	# rather than after stray empty lines. Indented bullets count as content.
	local last=$((${#lines[@]} - 1))
	while ((last >= 0)); do
		local line="${lines[last]}"
		if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*-[[:space:]]*$ ]]; then
			last=$((last - 1))
		else
			break
		fi
	done

	# Rewrite the note up to the last real line, then append the entry.
	{
		local i
		for ((i = 0; i <= last; i++)); do
			printf '%s\n' "${lines[i]}"
		done
		# Keep a blank line under a heading or other non-bullet line.
		if ((last >= 0)) && [[ ! "${lines[last]}" =~ ^[[:space:]]*- ]]; then
			printf '\n'
		fi
		printf -- '- %s %s\n' "$(date +%H%M)" "$text"
	} >"$file"
}

main() {
	if [[ "$#" -eq 0 ]]; then
		usage >&2
		exit 2
	fi

	local command="$1"
	shift

	case "$command" in
	new)
		cmd_new
		;;
	add)
		[[ "$#" -ge 1 ]] || die "add requires <text>"
		cmd_add "$*"
		;;
	-h | --help | help)
		usage
		;;
	*)
		echo "Unknown command: $command" >&2
		usage >&2
		exit 2
		;;
	esac
}

main "$@"
