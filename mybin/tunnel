#!/usr/bin/env bash
#
# Manage named SSH tunnels.
#
# Each tunnel is defined in its own file: ~/.config/tunnel/<name>.conf
# (override the directory with $TUNNEL_CONF_DIR). The file is sourced and
# must set all of the following variables.
#
# Example (~/.config/tunnel/home-assistant.conf):
#
#   LOCAL_HOST=127.0.0.1
#   LOCAL_PORT=8123
#   REMOTE_HOST=192.168.1.2
#   REMOTE_PORT=8123
#   SSH_HOST=home
#
# Usage:
#
#   tunnel <name> [up|down|toggle|status]
#   tunnel list
#   tunnel names
#
# Tab-completion is provided by ~/.bashrc_scripts/tunnel.sh.
#
# PID files are stored as ~/.tunnel-<name>.pid

set -euo pipefail

readonly CONF_DIR="${TUNNEL_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tunnel}"

usage() {
  echo "Usage: $(basename "$0") <name> [up|down|toggle|status]"
  echo "       $(basename "$0") list"
  echo "       $(basename "$0") names"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

check_conf_dir() {
  if [[ ! -d "$CONF_DIR" ]]; then
    cat >&2 <<EOF
Error: missing config directory: $CONF_DIR

Create one file per tunnel, e.g. $CONF_DIR/home-assistant.conf:

  LOCAL_HOST=127.0.0.1
  LOCAL_PORT=8123
  REMOTE_HOST=192.168.1.2
  REMOTE_PORT=8123
  SSH_HOST=home

Then rerun this script.
EOF
    exit 1
  fi
}

# List configured tunnel names (basename without .conf), one per line.
list_names() {
  local file name
  [[ -d "$CONF_DIR" ]] || return 0
  for file in "$CONF_DIR"/*.conf; do
    [[ -e "$file" ]] || continue
    name="${file##*/}"
    echo "${name%.conf}"
  done
}

load_tunnel() {
  local name="$1"
  local conf="${CONF_DIR}/${name}.conf"

  [[ -f "$conf" ]] || die "no tunnel named '$name' in $CONF_DIR"

  # shellcheck source=/dev/null
  source "$conf"

  PID_FILE="${HOME}/.tunnel-${name}.pid"

  : "${LOCAL_HOST:?missing LOCAL_HOST in $conf}"
  : "${LOCAL_PORT:?missing LOCAL_PORT in $conf}"
  : "${REMOTE_HOST:?missing REMOTE_HOST in $conf}"
  : "${REMOTE_PORT:?missing REMOTE_PORT in $conf}"
  : "${SSH_HOST:?missing SSH_HOST in $conf}"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

tunnel_up() {
  need_cmd ssh

  if is_running; then
    echo "Tunnel already running."
    echo "PID: $(cat "$PID_FILE")"
    echo "URL: http://${LOCAL_HOST}:${LOCAL_PORT}"
    exit 0
  fi

  rm -f "$PID_FILE"

  echo "Starting tunnel:"
  echo "  local:  ${LOCAL_HOST}:${LOCAL_PORT}"
  echo "  remote: ${REMOTE_HOST}:${REMOTE_PORT}"
  echo "  ssh:    ${SSH_HOST}"

  ssh -fN \
    -L "${LOCAL_HOST}:${LOCAL_PORT}:${REMOTE_HOST}:${REMOTE_PORT}" \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=3 \
    "$SSH_HOST"

  # Find the tunnel process. Yes, this is ugly. So is process management in shell.
  local pid
  pid="$(pgrep -f "ssh .*${LOCAL_HOST}:${LOCAL_PORT}:${REMOTE_HOST}:${REMOTE_PORT}.*${SSH_HOST}" | head -n 1 || true)"

  if [[ -z "$pid" ]]; then
    die "tunnel seems to have started, but could not find SSH process"
  fi

  echo "$pid" >"$PID_FILE"

  echo "Tunnel started."
  echo "PID: $pid"
  echo "URL: http://${LOCAL_HOST}:${LOCAL_PORT}"
}

tunnel_down() {
  if ! is_running; then
    echo "Tunnel not running."
    rm -f "$PID_FILE"
    exit 0
  fi

  local pid
  pid="$(cat "$PID_FILE")"

  echo "Stopping tunnel PID $pid"
  kill "$pid"
  rm -f "$PID_FILE"
  echo "Tunnel stopped."
}

tunnel_status() {
  if is_running; then
    echo "Tunnel running."
    echo "PID: $(cat "$PID_FILE")"
    echo "URL: http://${LOCAL_HOST}:${LOCAL_PORT}"
  else
    echo "Tunnel not running."
    rm -f "$PID_FILE"
  fi
}

tunnel_list() {
  local name
  while IFS= read -r name; do
    PID_FILE="${HOME}/.tunnel-${name}.pid"
    if is_running; then
      echo "  ${name}  [running, PID $(cat "$PID_FILE")]"
    else
      echo "  ${name}  [stopped]"
    fi
  done < <(list_names)
}

main() {
  case "${1:-}" in
    -h | --help | help)
      usage
      exit 0
      ;;
    names)
      # Used by tab-completion, so stay quiet if nothing is configured.
      list_names
      exit 0
      ;;
  esac

  check_conf_dir

  local tunnel_name="${1:-}"
  local subcommand="${2:-toggle}"

  case "$tunnel_name" in
    "" | list)
      tunnel_list
      exit 0
      ;;
  esac

  load_tunnel "$tunnel_name"

  case "$subcommand" in
    up | start)
      tunnel_up
      ;;
    down | stop)
      tunnel_down
      ;;
    toggle)
      if is_running; then
        tunnel_down
      else
        tunnel_up
      fi
      ;;
    status)
      tunnel_status
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
