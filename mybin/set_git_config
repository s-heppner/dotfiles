#!/usr/bin/env bash
#
# Set the git identity (user.name and user.email) of the current repository
# from a named profile.
#
# Each profile is defined in its own file:
# ~/.config/s-heppner/set_git_config/<name>.conf (override the directory with
# $SET_GIT_CONFIG_DIR). The file is sourced and must set all of the following
# variables. The profiles live outside this repo, so no identity is committed
# here.
#
# Example (~/.config/s-heppner/set_git_config/private.conf):
#
#   NAME="Jane Doe"
#   EMAIL=jane@example.com
#
# Usage:
#
#   set_git_config <profile>
#   set_git_config list
#   set_git_config names
#
# Tab-completion is provided by ~/.bashrc_scripts/set_git_config.sh.

set -euo pipefail

readonly CONF_DIR="${SET_GIT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/s-heppner/set_git_config}"

usage() {
  echo "Usage: $(basename "$0") <profile>"
  echo "       $(basename "$0") list"
  echo "       $(basename "$0") names"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

check_conf_dir() {
  if [[ ! -d "$CONF_DIR" ]]; then
    cat >&2 <<EOF
Error: missing config directory: $CONF_DIR

Create one file per profile, e.g. $CONF_DIR/private.conf:

  NAME="Jane Doe"
  EMAIL=jane@example.com

Then rerun this script.
EOF
    exit 1
  fi
}

# List configured profile names (basename without .conf), one per line.
list_names() {
  local file name
  [[ -d "$CONF_DIR" ]] || return 0
  for file in "$CONF_DIR"/*.conf; do
    [[ -e "$file" ]] || continue
    name="${file##*/}"
    echo "${name%.conf}"
  done
}

load_profile() {
  local name="$1"
  local conf="${CONF_DIR}/${name}.conf"

  [[ -f "$conf" ]] || die "no profile named '$name' in $CONF_DIR"

  # Clear values from a previously loaded profile.
  NAME=""
  EMAIL=""

  # shellcheck source=/dev/null
  source "$conf"

  : "${NAME:?missing NAME in $conf}"
  : "${EMAIL:?missing EMAIL in $conf}"
}

# List profiles, marking the one whose e-mail matches the current identity.
profile_list() {
  local current name
  current="$(git config --get user.email 2>/dev/null || true)"
  while IFS= read -r name; do
    load_profile "$name"
    if [[ -n "$current" && "$EMAIL" == "$current" ]]; then
      echo "* ${name}  (${NAME} <${EMAIL}>)"
    else
      echo "  ${name}  (${NAME} <${EMAIL}>)"
    fi
  done < <(list_names)
}

profile_set() {
  local name="$1"
  local repo

  load_profile "$name"

  repo="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    die "not inside a git repository: $PWD"

  git config user.name "$NAME"
  git config user.email "$EMAIL"

  echo "Set git config for ${repo} (profile: ${name}):"
  echo "  user.name:  ${NAME}"
  echo "  user.email: ${EMAIL}"
}

main() {
  case "${1:-}" in
    -h | --help | help)
      usage
      exit 0
      ;;
    names)
      # Used by tab-completion, so stay quiet if nothing is configured.
      list_names
      exit 0
      ;;
  esac

  check_conf_dir

  case "${1:-}" in
    "" | list)
      profile_list
      ;;
    *)
      [[ $# -eq 1 ]] || {
        usage >&2
        exit 2
      }
      profile_set "$1"
      ;;
  esac
}

main "$@"
