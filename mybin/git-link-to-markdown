#!/usr/bin/env bash
#
# Convert a git hosting URL into a Markdown link.
#
# The URL is taken from, in order of precedence: the first argument, standard
# input, or the X clipboard. The Markdown link is printed to stdout; when the
# URL came from the clipboard, the result is also copied back to it.
#
# Supported hosts:
#   - github.com
#   - git.s-heppner.com      (Gitea)
#   - git.rwth-aachen.de     (GitLab)
#   - git-ce.rwth-aachen.de  (GitLab CE)
#
# How to use:
#
#   git-link-to-markdown                 Convert the URL on the clipboard
#   git-link-to-markdown <url>           Convert the given URL
#   echo <url> | git-link-to-markdown    Convert a URL from stdin
#
# Examples:
#   https://github.com/user/repo                  -> [user/repo](url)
#   https://github.com/user/repo/issues/42        -> [user/repo#42](url)
#   https://github.com/user/repo/pull/7           -> [user/repo#7](url)
#   https://github.com/user/repo/tree/main        -> [user/repo/main](url)
#   https://github.com/user/repo/blob/main/foo.rs -> [user/repo/blob/main/foo.rs](url)
#   https://github.com/user/repo/commit/abc1234f  -> [user/repo/abc1234](url)

set -euo pipefail

usage() {
	echo "Usage: $(basename "$0") [url]"
}

die() {
	echo "Error: $*" >&2
	exit 1
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

# parse_link <url> <base>
#
# Strips <base> from <url>, splits the remaining path into components, and
# prints a Markdown link in one of these forms:
#
#   [user/repo](url)                 — repo root
#   [user/repo#number](url)          — issue or pull request
#   [user/repo/branch](url)          — tree (branch view)
#   [user/repo/abc1234](url)         — commit (full SHA shortened to 7 chars)
#   [user/repo/some/path](url)       — any other path (blob, releases, etc.)
parse_link() {
	local url="$1"
	local base="$2"

	# Remove the base URL prefix, then strip any leading slash.
	local path="${url#"$base"}"
	path="${path#/}"

	# Split the path into an array on '/'.
	# e.g. "user/repo/issues/42" -> parts=(user repo issues 42)
	local parts
	IFS='/' read -ra parts <<<"$path"

	local user="${parts[0]}"
	local repo="${parts[1]}"

	if [[ -z "$user" || -z "$repo" ]]; then
		die "invalid URL structure: $url"
	fi

	# No path beyond user/repo — link directly to the repo root.
	if [[ "${#parts[@]}" -le 2 ]]; then
		echo "[${user}/${repo}](${url})"
		return 0
	fi

	# The third component tells us what kind of page this is.
	local page_type="${parts[2]}"

	case "$page_type" in
	issues | pull | pulls)
		# Issue or pull request: .../issues/42 or .../pull/7 or .../pulls/3
		local number="${parts[3]}"
		[[ -n "$number" ]] || die "'${page_type}' found but no number in URL: $url"
		echo "[${user}/${repo}#${number}](${url})"
		;;
	tree)
		# Branch view: .../tree/main
		local branch="${parts[3]}"
		[[ -n "$branch" ]] || die "'tree' found but no branch name in URL: $url"
		echo "[${user}/${repo}/${branch}](${url})"
		;;
	commit)
		# Commit view: .../commit/abc1234ef56...
		# Shorten the full SHA to 7 characters (Git's default abbrev length).
		local full_hash="${parts[3]}"
		[[ -n "$full_hash" ]] || die "'commit' found but no hash in URL: $url"
		echo "[${user}/${repo}/${full_hash:0:7}](${url})"
		;;
	*)
		# Everything else (blob, releases, …): keep the full path.
		local remaining_path
		remaining_path=$(
			IFS='/'
			echo "${parts[*]:2}"
		)
		echo "[${user}/${repo}/${remaining_path}](${url})"
		;;
	esac
}

# url_to_markdown <url>
#
# Routes <url> to parse_link based on its host prefix.
url_to_markdown() {
	local url="$1"
	case "$url" in
	https://github.com*) parse_link "$url" "https://github.com" ;;
	https://git.s-heppner.com*) parse_link "$url" "https://git.s-heppner.com" ;;
	https://git.rwth-aachen.de*) parse_link "$url" "https://git.rwth-aachen.de" ;;
	https://git-ce.rwth-aachen.de*) parse_link "$url" "https://git-ce.rwth-aachen.de" ;;
	*) die "no recognised git URL: $url" ;;
	esac
}

main() {
	case "${1:-}" in
	-h | --help)
		usage
		exit 0
		;;
	esac

	local url from_clipboard=false
	if (($# >= 1)); then
		url="$1"
	elif [[ ! -t 0 ]]; then
		read -r url || true
	else
		need_cmd xclip
		url=$(xclip -selection clipboard -o 2>/dev/null) || die "failed to read clipboard"
		from_clipboard=true
	fi

	# Trim surrounding whitespace (e.g. a trailing newline from the clipboard).
	url=$(printf '%s' "$url" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	[[ -n "$url" ]] || die "no URL provided"

	local markdown
	markdown=$(url_to_markdown "$url")

	echo "$markdown"

	if [[ "$from_clipboard" == true ]]; then
		printf '%s' "$markdown" | xclip -selection clipboard
	fi
}

main "$@"
