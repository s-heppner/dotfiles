#!/usr/bin/env bash
#
# Concatenates all .mp4 files in a directory (sorted by name) into a single
# timelapse video, speeding it up by SPEED and re-encoding to HEVC (libx265).
#
# How to use:
#
#   timelapse-videos-from-dir <path/to/videos> <speed>
#
# Example:
#
#   timelapse-videos-from-dir ~/Videos/timelapse 10   # 10x speedup

set -euo pipefail
shopt -s nullglob

LIST_FILE=""

cleanup() {
  [[ -n "$LIST_FILE" ]] && rm -f "$LIST_FILE"
}

trap cleanup EXIT

usage() {
  echo "Usage: $(basename "$0") <path/to/videos> <speed>"
  echo "  path/to/videos : directory containing .mp4 files"
  echo "  speed          : timelapse multiplier (e.g. 10 = 10x faster)"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

build_file_list() {
  local dir="$1"
  local list_file="$2"
  local f

  for f in "$dir"/*.mp4; do
    echo "file '$(realpath "$f")'" >>"$list_file"
  done

  [[ -s "$list_file" ]] || die "no .mp4 files found in $dir"
}

create_timelapse() {
  local list_file="$1"
  local speed="$2"
  local output="$3"

  ffmpeg -y -f concat -safe 0 -i "$list_file" \
    -vf "setpts=(1/${speed})*PTS,zscale=rangein=full:range=limited,fps=60,format=yuv420p" \
    -c:v libx265 -preset slow -crf 18 -tune grain -x265-params "no-sao=1:keyint=30" \
    -tag:v hvc1 -movflags +faststart -an "$output"
}

main() {
  local -a positional=()

  while (($#)); do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        echo "Error: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
      *)
        positional+=("$1")
        ;;
    esac
    shift
  done

  if ((${#positional[@]} != 2)); then
    usage >&2
    exit 2
  fi

  local dir="${positional[0]}"
  local speed="${positional[1]}"

  [[ -d "$dir" ]] || die "'$dir' is not a directory"
  [[ "$speed" =~ ^([0-9]*[.])?[0-9]+$ ]] || die "SPEED must be a number"

  need_cmd ffmpeg
  need_cmd realpath

  LIST_FILE="$(mktemp)"

  build_file_list "$dir" "$LIST_FILE"

  local output="$dir/timelapse.mp4"
  create_timelapse "$LIST_FILE" "$speed" "$output"

  echo "Timelapse created: $output"
}

main "$@"
