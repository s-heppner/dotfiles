#!/usr/bin/env bash
#
# umlaut-to-clipboard
#
# Writes a single German umlaut (or sharp s) to the clipboard, so it can be
# pasted on keyboards that have no dedicated key for it.
#
# Usage:
#   umlaut-to-clipboard <letter>
#
# Mapping:
#   a -> ä    A -> Ä
#   o -> ö    O -> Ö
#   u -> ü    U -> Ü
#   s -> ß
#
# Examples:
#   umlaut-to-clipboard u   -> ü on the clipboard
#   umlaut-to-clipboard s   -> ß on the clipboard

set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <letter>"
  echo "  a/o/u/s and their uppercase variants (a -> ä, s -> ß, ...)"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

umlaut_for() {
  local letter="$1"

  case "$letter" in
    a) echo "ä" ;;
    o) echo "ö" ;;
    u) echo "ü" ;;
    A) echo "Ä" ;;
    O) echo "Ö" ;;
    U) echo "Ü" ;;
    s) echo "ß" ;;
    *) die "no umlaut for '$letter' (expected one of a o u A O U s)" ;;
  esac
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  if [[ "$#" -ne 1 ]]; then
    usage >&2
    exit 2
  fi

  need_cmd xclip

  local umlaut
  umlaut="$(umlaut_for "$1")"

  echo -n "$umlaut" | xclip -selection clipboard || die "failed to copy umlaut to clipboard"
  echo "Umlaut '${umlaut}' copied to clipboard."
}

main "$@"
