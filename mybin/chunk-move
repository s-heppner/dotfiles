#!/usr/bin/env bash
#
# Split files in a directory into numbered chunk subdirectories.
#
# How to use:
#
#   chunk-move <directory> <chunk-size>

set -euo pipefail

usage() {
	echo "Usage: $(basename "$0") <directory> <chunk-size>"
}

die() {
	echo "Error: $*" >&2
	exit 1
}

move_files_into_chunks() {
	local dir="$1"
	local chunk_size="$2"

	local file_count
	file_count=$(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 | tr -cd '\0' | wc -c)
	if ((file_count == 0)); then
		echo "No files to move in '${dir}'."
		return
	fi

	local chunks=$(((file_count + chunk_size - 1) / chunk_size))
	local pad=${#chunks}
	((pad < 2)) && pad=2

	local i=0
	local current_chunk=0
	local this_chunk subdir f

	while IFS= read -r -d '' f; do
		this_chunk=$((i / chunk_size + 1))
		if ((this_chunk != current_chunk)); then
			current_chunk=$this_chunk
			printf "→ Moving files into chunk-%0*d\n" "$pad" "$current_chunk"
		fi

		subdir="${dir}/$(printf "chunk-%0*d" "$pad" "$current_chunk")"
		mkdir -p "$subdir"
		mv -n -- "$f" "$subdir"/

		i=$((i + 1))
	done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0)

	echo "Done. Moved ${file_count} files into ${chunks} chunk directories."
}

main() {
	if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
		usage
		exit 0
	fi

	if (($# != 2)); then
		usage >&2
		exit 2
	fi

	local dir="$1"
	local chunk_size="$2"

	[[ -d "$dir" ]] || die "'${dir}' is not a directory."
	[[ "$chunk_size" =~ ^[1-9][0-9]*$ ]] || die "chunk-size must be a positive integer."

	move_files_into_chunks "$dir" "$chunk_size"
}

main "$@"
